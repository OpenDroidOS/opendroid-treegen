      "mount_point": "/vendor",
      "fs_type": "ext4",
      "mount_options": ["ro", "barrier=1"],
      "manager_flags": ["wait"]
    }],
    "device_permissions": [{"path": "/dev/example*", "mode": "0660", "uid": "system", "gid": "system"}],
    "images": {"vendor": {"size_bytes": 268435456, "mount_point": "/vendor"}}
  },
